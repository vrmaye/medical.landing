---
import PackageSelector from './PackageSelector.astro';
import CheckoutForm from './CheckoutForm.astro';
---

<div
  id="checkout-modal-backdrop"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-1 sm:p-3 overflow-y-auto hidden opacity-0 transition-opacity duration-300"
>
  <div class="relative w-full max-w-xl max-h-[95vh] overflow-y-auto bg-slate-900 border border-amber-500/40 rounded-2xl p-3 sm:p-5 shadow-2xl text-white transform scale-95 transition-transform duration-300 my-auto">
    <!-- Close Button -->
    <button
      id="close-checkout-modal-btn"
      class="absolute top-3 right-3 z-10 text-slate-400 hover:text-white text-lg font-bold w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center cursor-pointer transition active:scale-90"
      aria-label="Cerrar modal de compra"
    >
      ✕
    </button>

    <!-- Modal Header -->
    <div class="text-center pt-1 pb-3 border-b border-slate-800 mb-3">
      <span class="inline-block bg-amber-500/20 text-amber-400 font-extrabold text-[10px] tracking-wider px-2 py-0.5 rounded-full uppercase mb-1 border border-amber-500/30">
        🛒 Proceso de Pedido Seguro
      </span>
      <h2 class="text-lg sm:text-xl font-black text-white uppercase tracking-tight">
        COMPLETÁ TU PEDIDO
      </h2>
    </div>

    <!-- Package Selector -->
    <PackageSelector />

    <!-- Form & Order Summary -->
    <CheckoutForm />
  </div>
</div>

<script>
  import {
    isCheckoutModalOpen,
    isExitModalOpen,
    exitAttempted,
    hasExitDiscountClaimed,
    setPackageOffers,
    setPackagesLoading,
  } from '../../stores/checkoutStore';
  import { getSupabaseClient } from '../../supabase/client';

  async function fetchPackages() {
    setPackagesLoading(true);
    try {
      const supabase = getSupabaseClient();
      const { data, error } = await supabase
        .from('packages')
        .select('*')
        .eq('is_active', true)
        .order('sort_order', { ascending: true });

      if (error || !data || data.length === 0) {
        console.warn('[Checkout] Supabase packages empty or failed');
        setPackagesLoading(false);
        return;
      }

      console.log('[Checkout] Packages from Supabase:', data);

      const mapped = data.map((row) => ({
        id: row.id,
        quantity: row.quantity,
        title: row.title,
        originalPricePerUnit: row.original_price_per_unit,
        discountPercentage: row.discount_percentage,
        badge: row.badge ?? undefined,
        isPopular: row.is_popular,
        isBestPrice: row.is_best_price,
        freeShipping: row.free_shipping,
        imageUrl: row.image_url ?? undefined,
      }));

      console.log('[Checkout] Mapped packages:', mapped);
      setPackageOffers(mapped);
    } catch (err) {
      console.warn('[Checkout] Failed to fetch packages:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('checkout-modal-backdrop');
    const closeBtn = document.getElementById('close-checkout-modal-btn');

    function handleCloseAttempt() {
      if (!exitAttempted.get() && !hasExitDiscountClaimed.get()) {
        exitAttempted.set(true);
        isExitModalOpen.set(true);
      } else {
        isCheckoutModalOpen.set(false);
      }
    }

    isCheckoutModalOpen.subscribe((isOpen) => {
      if (!backdrop) return;
      if (isOpen) {
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        fetchPackages();
        setTimeout(() => {
          backdrop.classList.remove('opacity-0');
          const container = backdrop.firstElementChild;
          if (container) container.classList.remove('scale-95');
        }, 10);
      } else {
        backdrop.classList.add('opacity-0');
        document.body.style.overflow = '';
        setTimeout(() => {
          backdrop.classList.add('hidden');
        }, 300);
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', handleCloseAttempt);
    }

    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) {
          handleCloseAttempt();
        }
      });
    }
  });
</script>
