---
import PackageSelector from './PackageSelector.astro';
import CheckoutForm from './CheckoutForm.astro';
---

<div
  id="checkout-modal-backdrop"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-2 sm:p-4 overflow-y-auto hidden opacity-0 transition-opacity duration-300"
>
  <div class="relative w-full max-w-xl max-h-[92vh] overflow-y-auto bg-slate-900 border border-amber-500/40 rounded-3xl p-4 sm:p-6 shadow-2xl text-white transform scale-95 transition-transform duration-300 my-auto">
    <!-- Close Button -->
    <button
      id="close-checkout-modal-btn"
      class="absolute top-4 right-4 z-10 text-slate-400 hover:text-white text-xl font-bold w-9 h-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center cursor-pointer transition active:scale-90"
      aria-label="Cerrar modal de compra"
    >
      ✕
    </button>

    <!-- Modal Header -->
    <div class="text-center pt-2 pb-4 border-b border-slate-800 mb-4">
      <span class="inline-block bg-amber-500/20 text-amber-400 font-extrabold text-xs tracking-wider px-3 py-1 rounded-full uppercase mb-1 border border-amber-500/30">
        🛒 Proceso de Pedido Seguro
      </span>
      <h2 class="text-xl sm:text-2xl font-black text-white uppercase tracking-tight">
        COMPLETÁ TU PEDIDO
      </h2>
      <p class="text-xs text-slate-400">
        Pagas únicamente al recibir tu producto en casa (Contra Entrega)
      </p>
    </div>

    <!-- Package Selector -->
    <PackageSelector />

    <!-- Form & Order Summary -->
    <CheckoutForm />
  </div>
</div>

<script>
  import {
    isCheckoutModalOpen,
    isExitModalOpen,
    exitAttempted,
    hasExitDiscountClaimed,
  } from '../../stores/checkoutStore';

  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('checkout-modal-backdrop');
    const closeBtn = document.getElementById('close-checkout-modal-btn');

    function handleCloseAttempt() {
      // If user hasn't seen the exit discount offer yet, show exit modal ON TOP!
      if (!exitAttempted.get() && !hasExitDiscountClaimed.get()) {
        exitAttempted.set(true);
        isExitModalOpen.set(true); // Pops up ExitIntentModal (z-60) over CheckoutModal (z-50)
      } else {
        // If exit offer was already shown/closed or claimed, close checkout modal
        isCheckoutModalOpen.set(false);
      }
    }

    isCheckoutModalOpen.subscribe((isOpen) => {
      if (!backdrop) return;
      if (isOpen) {
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
          backdrop.classList.remove('opacity-0');
          const container = backdrop.firstElementChild;
          if (container) container.classList.remove('scale-95');
        }, 10);
      } else {
        backdrop.classList.add('opacity-0');
        document.body.style.overflow = '';
        setTimeout(() => {
          backdrop.classList.add('hidden');
        }, 300);
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', handleCloseAttempt);
    }

    // Close on backdrop click (also triggers exit attempt logic)
    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) {
          handleCloseAttempt();
        }
      });
    }
  });
</script>
