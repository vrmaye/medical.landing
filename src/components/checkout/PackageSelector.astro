<div class="w-full max-w-xl mx-auto px-2 py-3 bg-slate-900 text-white rounded-2xl shadow-2xl border border-slate-800 my-3">
  <div class="text-center mb-3">
    <span class="inline-block bg-amber-500/20 text-amber-400 font-extrabold text-[10px] tracking-wider px-2 py-0.5 rounded-full uppercase mb-1 border border-amber-500/30">
      Paso 1: Selecciona tu Oferta
    </span>
    <h2 class="text-lg sm:text-2xl font-black text-amber-400 tracking-tight">
      ELIJE TU PAQUETE
    </h2>
  </div>

  <div id="package-offers-container" class="grid grid-cols-1 gap-2">
    <!-- Rendered dynamically via JS client script -->
  </div>
</div>

<script>
  import { packageOffersStore, selectedPackageId, packagesLoading } from '../../stores/checkoutStore';
  import type { PackageOffer } from '../../types/landing';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('package-offers-container');

    function renderPackages(offers: PackageOffer[], currentSelectedId: string, loading: boolean) {
      if (!container) return;
      container.innerHTML = '';

      if (loading) {
        container.innerHTML = `
          <div class="flex flex-col items-center justify-center py-8 gap-3">
            <div class="w-8 h-8 border-2 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
            <p class="text-sm text-slate-400">Cargando paquetes...</p>
          </div>
        `;
        return;
      }

      if (offers.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8">
            <p class="text-sm text-slate-400">No hay paquetes disponibles</p>
          </div>
        `;
        return;
      }

      offers.forEach((pkg) => {
        const baseTotal = pkg.originalPricePerUnit * pkg.quantity;
        const discount = (baseTotal * pkg.discountPercentage) / 100;
        const finalPrice = baseTotal - discount;
        const isSelected = pkg.id === currentSelectedId;

        const card = document.createElement('div');
        card.setAttribute('data-package-id', pkg.id);
        card.className = `
          package-card group relative p-2.5 rounded-xl cursor-pointer border-2 transition-all duration-300
          ${
            isSelected
              ? 'border-amber-400 ring-2 ring-amber-400/40 bg-slate-800/90 shadow-lg shadow-amber-500/10'
              : pkg.isPopular
              ? 'border-amber-400/60 bg-slate-800/80 hover:border-amber-400'
              : pkg.isBestPrice
              ? 'border-emerald-500/60 bg-slate-800/80 hover:border-emerald-500'
              : 'border-slate-700 bg-slate-800/50 hover:border-slate-600'
          }
        `;

        card.innerHTML = `
          ${pkg.badge ? `
            <div class="absolute -top-2 right-2 text-[10px] font-black px-2 py-0.5 rounded-full uppercase tracking-wider shadow-md text-white ${pkg.isPopular ? 'bg-amber-500' : 'bg-emerald-500'}">
              ${pkg.badge}
            </div>
          ` : ''}
          <div class="flex items-center gap-2">
            <input
              type="radio"
              name="package_selection"
              value="${pkg.id}"
              ${isSelected ? 'checked' : ''}
              class="w-4 h-4 accent-amber-500 cursor-pointer flex-shrink-0"
            />
            ${pkg.imageUrl ? `
              <img src="${pkg.imageUrl}" alt="${pkg.title}" class="w-11 h-11 sm:w-12 sm:h-12 object-cover rounded-lg shadow-md flex-shrink-0" />
            ` : ''}
            <div class="flex-1 min-w-0">
              <h3 class="font-extrabold text-[13px] sm:text-sm text-white group-hover:text-amber-300 transition-colors leading-tight">
                ${pkg.title}
              </h3>
              <div class="flex items-center gap-1 text-[10px] sm:text-xs text-slate-300 mt-0.5">
                ${pkg.freeShipping ? `
                  <span class="inline-flex items-center gap-0.5 text-emerald-400 font-semibold">
                    <span>🚚</span> Envío Gratis
                  </span>
                ` : ''}
                ${pkg.discountPercentage > 0 ? `
                  <span class="bg-red-500/20 text-red-400 font-bold px-1 py-0.5 rounded">
                    -${pkg.discountPercentage}%
                  </span>
                ` : ''}
              </div>
            </div>
            <div class="text-right whitespace-nowrap flex-shrink-0">
              ${pkg.discountPercentage > 0 ? `
                <div class="text-[10px] text-slate-400 line-through font-semibold">
                  S/ ${baseTotal.toFixed(2)}
                </div>
              ` : ''}
              <div class="text-sm sm:text-base font-black text-amber-400">
                S/ ${finalPrice.toFixed(2)}
              </div>
            </div>
          </div>
        `;

        card.addEventListener('click', () => {
          selectedPackageId.set(pkg.id);
        });

        container.appendChild(card);
      });
    }

    // Subscribe to package store & selection changes
    packageOffersStore.subscribe((offers) => {
      renderPackages(offers, selectedPackageId.get(), packagesLoading.get());
    });

    packagesLoading.subscribe((loading) => {
      renderPackages(packageOffersStore.get(), selectedPackageId.get(), loading);
    });

    selectedPackageId.subscribe((id) => {
      renderPackages(packageOffersStore.get(), id, packagesLoading.get());
    });
  });
</script>
