<div class="w-full bg-slate-950 p-3 sm:p-4 rounded-xl border border-slate-800 my-3 text-slate-200">
  <h3 class="text-xs sm:text-sm font-extrabold text-amber-400 uppercase tracking-wider mb-2 flex items-center gap-1">
    <span>📋</span> Resumen
  </h3>

  <div class="space-y-1.5 text-[11px] sm:text-xs">
    <div class="flex justify-between items-center text-slate-300">
      <span>Subtotal:</span>
      <span id="summary-subtotal" class="font-semibold text-white">S/ 0</span>
    </div>

    <div id="summary-pkg-discount-row" class="flex justify-between items-center text-emerald-400 font-medium">
      <span>Descuento Paquete:</span>
      <span id="summary-pkg-discount">-S/ 0</span>
    </div>

    <div id="summary-extra-discount-row" class="hidden flex justify-between items-center text-amber-400 font-bold bg-amber-500/10 p-1.5 rounded-lg border border-amber-500/20">
      <span class="flex items-center gap-1">
        <span>🎁</span> Extra (<span id="extra-discount-percent">0</span>%):
      </span>
      <span id="summary-extra-discount">-S/ 0</span>
    </div>

    <div class="flex justify-between items-center text-slate-300">
      <span>Envío:</span>
      <span id="summary-shipping" class="font-semibold text-emerald-400">¡GRATIS!</span>
    </div>

    <div class="border-t border-slate-800 pt-2 mt-1.5 flex justify-between items-baseline">
      <div>
        <span class="text-sm sm:text-base font-black text-white block">TOTAL:</span>
        <span class="text-[9px] text-slate-400 font-medium">Pagas al recibir</span>
      </div>
      <div class="text-right">
        <span id="summary-final-total" class="text-xl sm:text-2xl font-black text-amber-400">
          S/ 0
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  import { checkoutPricing } from '../../stores/checkoutStore';

  document.addEventListener('DOMContentLoaded', () => {
    const elSubtotal = document.getElementById('summary-subtotal');
    const elPkgDiscount = document.getElementById('summary-pkg-discount');
    const elPkgDiscountRow = document.getElementById('summary-pkg-discount-row');
    const elExtraDiscountRow = document.getElementById('summary-extra-discount-row');
    const elExtraPercent = document.getElementById('extra-discount-percent');
    const elExtraDiscount = document.getElementById('summary-extra-discount');
    const elShipping = document.getElementById('summary-shipping');
    const elFinalTotal = document.getElementById('summary-final-total');

    checkoutPricing.subscribe((pricing) => {
      if (elSubtotal) elSubtotal.textContent = `S/ ${pricing.totalBasePrice.toFixed(2)}`;
      
      if (elPkgDiscount && elPkgDiscountRow) {
        if (pricing.packageDiscountAmount > 0) {
          elPkgDiscount.textContent = `-S/ ${pricing.packageDiscountAmount.toFixed(2)}`;
          elPkgDiscountRow.classList.remove('hidden');
        } else {
          elPkgDiscountRow.classList.add('hidden');
        }
      }

      if (elExtraDiscountRow && elExtraPercent && elExtraDiscount) {
        if (pricing.extraDiscountPercentage > 0) {
          elExtraPercent.textContent = pricing.extraDiscountPercentage.toString();
          elExtraDiscount.textContent = `-S/ ${pricing.extraDiscountAmount.toFixed(2)}`;
          elExtraDiscountRow.classList.remove('hidden');
        } else {
          elExtraDiscountRow.classList.add('hidden');
        }
      }

      if (elShipping) {
        elShipping.textContent = pricing.shippingCost === 0 ? '¡GRATIS!' : `S/ ${pricing.shippingCost.toFixed(2)}`;
      }

      if (elFinalTotal) {
        elFinalTotal.textContent = `S/ ${pricing.finalPriceTotal.toFixed(2)}`;
      }
    });
  });
</script>
